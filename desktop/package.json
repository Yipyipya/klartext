{
  "name": "klartext-desktop",
  "version": "0.2.2",
  "private": true,
  "description": "Klartext Desktop – systemweites Diktat per globalem Shortcut, Text landet direkt an der Cursor-Position",
  "main": "main.js",
  "scripts": {
    "bundle:wake": "node build-wake.js",
    "prestart": "npm run bundle:wake",
    "start": "electron .",
    "icon": "node make-icon.js",
    "predist": "npm run bundle:wake",
    "dist": "electron-builder --mac dmg",
    "predist:win": "npm run bundle:wake",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "app.klartext.desktop",
    "productName": "Klartext",
    "afterPack": "adhoc-sign.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "runtime.js",
      "audio-runtime.js",
      "accessibility.js",
      "wake-controller.js",
      "wake-runtime.js",
      "wake-preload.js",
      "wake-bundle.js",
      "wakesetup-bundle.js",
      "wake.html",
      "wakekey.html",
      "rustpotter-worker.js",
      "rustpotter-worklet.js",
      "rustpotter-runtime.wasm",
      "rustpotter-creator.wasm",
      "rustpotter-LICENSE.txt",
      "startup.js",
      "preload.js",
      "pill.html",
      "keywin.html",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "Klartext-Mac-AppleSilicon.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Klartext nutzt dein Mikrofon zum Diktieren.",
        "LSUIElement": true
      }
    },
    "win": {
      "artifactName": "Klartext-Windows.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Klartext"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "rustpotter-web": "3.0.2",
    "rustpotter-worklet": "3.0.3"
  }
}
